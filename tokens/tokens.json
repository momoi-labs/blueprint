{
  "$schema": "https://www.designtokens.org/schema/2025.10/tokens.json",
  "$description": "Kiso colour tokens — DTCG 2025.10. Two layers in separate namespaces: color.* is the primitive palette, semantic.* is the 15 published roles (emitted as --color-<role>). Dark is the default $value; light (\"sand\") lives in $extensions.mode.light. Components consume semantic.* only.",
  "color": {
    "$type": "color",
    "$description": "Primitive layer — the raw palette. Not consumed directly by components.",
    "white": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      },
      "$description": "Pure white. Light theme elevated surface."
    },
    "black": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "hex": "#000000"
      },
      "$description": "Pure black. Reserved for overlays and shadows."
    },
