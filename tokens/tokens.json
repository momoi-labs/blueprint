  "semantic": {
    "$type": "color",
    "$description": "Semantic layer — the 15 published roles. Each aliases a primitive; every role carries dark and light in $extensions.mode. Emitted as --color-<role>.",
    "background": {
      "$value": "{color.neutral.900}",
      "$description": "App canvas. Surface role, never text.",
      "$extensions": {
        "mode": {
          "dark": "{color.neutral.900}",
          "light": "{color.neutral.200}"
        }
      }
    },
    "surface": {
      "$value": "{color.neutral.800}",
      "$description": "Cards, panels, table rows. Surface role.",
      "$extensions": {
        "mode": {
          "dark": "{color.neutral.800}",
          "light": "{color.neutral.100}"
        }
      }
    },
    "elevated-surface": {
      "$value": "{color.neutral.700}",
      "$description": "Menus, popovers, dialogs. Surface role.",
      "$extensions": {
        "mode": {
          "dark": "{color.neutral.700}",
          "light": "{color.white}"
        }
      }
    },
    "foreground": {
      "$value": "{color.neutral.100}",
      "$description": "Primary text. Text-eligible: passes WCAG AA 4.5:1 on background, surface and elevated-surface in both themes.",
      "$extensions": {
        "mode": {
          "dark": "{color.neutral.100}",
          "light": "{color.neutral.900}"
        }
      }
    },
    "muted-foreground": {
      "$value": "{color.neutral.400}",
      "$description": "Secondary text, labels. Text-eligible: passes WCAG AA 4.5:1 on background, surface and elevated-surface in both themes.",
      "$extensions": {
        "mode": {
          "dark": "{color.neutral.400}",
          "light": "{color.neutral.600}"
        }
      }
    },
    "subtle-foreground": {
      "$value": "{color.neutral.500}",
      "$description": "Placeholders, timestamps, hints. Large text and non-essential metadata only (>=3:1). Never body copy.",
      "$extensions": {
        "mode": {
          "dark": "{color.neutral.500}",
          "light": "{color.neutral.500}"
        }
      }
    },
    "border": {
      "$value": "{color.neutral.600}",
      "$description": "Dividers and input outlines. Non-text role.",
      "$extensions": {
        "mode": {
          "dark": "{color.neutral.600}",
          "light": "{color.neutral.300}"
        }
      }
    },
    "primary": {
      "$value": "{color.accent.base}",
      "$description": "Primary interactive colour: links, active state, primary button fill. Text-eligible: passes WCAG AA 4.5:1 on background, surface and elevated-surface in both themes.",
      "$extensions": {
        "mode": {
          "dark": "{color.accent.base}",
          "light": "{color.accent.base}"
        }
      }
    },
    "accent": {
      "$value": "{color.accent.300}",
      "$description": "Emphasis and highlight. Text-eligible: passes WCAG AA 4.5:1 on background, surface and elevated-surface in both themes.",
      "$extensions": {
        "mode": {
          "dark": "{color.accent.300}",
          "light": "{color.accent.800}"
        }
      }
    },
    "success": {
      "$value": "{color.status.success}",
      "$description": "Positive state. Text-eligible: passes WCAG AA 4.5:1 on background, surface and elevated-surface in both themes.",
      "$extensions": {
        "mode": {
          "dark": "{color.status.success}",
          "light": "{color.status.success}"
        }
      }
    },
    "warning": {
      "$value": "{color.status.warning}",
      "$description": "Caution state. Text-eligible: passes WCAG AA 4.5:1 on background, surface and elevated-surface in both themes.",
      "$extensions": {
        "mode": {
          "dark": "{color.status.warning}",
          "light": "{color.status.warning}"
        }
      }
    },
    "danger": {
      "$value": "{color.status.danger}",
      "$description": "Destructive or error state. Text-eligible: passes WCAG AA 4.5:1 on background, surface and elevated-surface in both themes.",
      "$extensions": {
        "mode": {
          "dark": "{color.status.danger}",
          "light": "{color.status.danger}"
        }
      }
    },
    "info": {
      "$value": "{color.status.info}",
      "$description": "Neutral informational state. Text-eligible: passes WCAG AA 4.5:1 on background, surface and elevated-surface in both themes.",
      "$extensions": {
        "mode": {
          "dark": "{color.status.info}",
          "light": "{color.status.info}"
        }
      }
    },
    "focus": {
      "$value": "{color.accent.300}",
      "$description": "Focus ring. Non-text role. >=3:1 against background.",
      "$extensions": {
        "mode": {
          "dark": "{color.accent.300}",
          "light": "{color.accent.base}"
        }
      }
    },
    "disabled": {
      "$value": "{color.neutral.600}",
      "$description": "Disabled text and controls. Exempt from contrast minimums per WCAG 1.4.3.",
      "$extensions": {
        "mode": {
          "dark": "{color.neutral.600}",
          "light": "{color.neutral.400}"
        }
      }
    }
  },
  "font": {
    "$description": "Font families. Inter for heading and body — hierarchy comes from size and weight, not a second family. JetBrains Mono for code and data. Keeps the site's stack, with system fallbacks added.",
    "heading": {
      "$type": "fontFamily",
      "$value": ["Inter", "system-ui", "sans-serif"],
      "$description": "Heading family. Inter, same as body; headings differentiate by size and weight."
    },
    "body": {
      "$type": "fontFamily",
      "$value": ["Inter", "system-ui", "sans-serif"],
      "$description": "Body family. Inter for interface text."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "ui-monospace", "monospace"],
      "$description": "Monospace family. Code and data values."
    },
    "variant-numeric": {
      "$value": "tabular-nums",
      "$description": "Font-feature value for numeric and data text: font-variant-numeric: tabular-nums keeps digit widths stable in tables and data readouts (\"precise\")."
    }
  },
  "type": {
    "$description": "Type scale on a minor third (1.2) modular scale anchored at 16px, steps -2..+4 rounded to whole pixels: 11, 13, 16, 19, 23, 28, 33. Rationalized from the site's ad-hoc fractional band (11-15, 24, 34, 48) — same range, clean defensible steps. type.role.* assembles these steps into the published text roles: display, heading, body, label, metadata, code, numeric.",
    "size": {
      "$type": "dimension",
      "$description": "Font sizes — one token per modular-scale step.",
      "metadata": {
        "$value": "11px",
        "$description": "Step -2. Captions, timestamps, footnotes, table metadata."
      },
      "label": {
        "$value": "13px",
        "$description": "Step -1. Labels, buttons, form captions, small UI text."
      },
      "body": {
        "$value": "16px",
        "$description": "Step 0. Body copy; base size for code and numeric text."
      },
      "h3": {
        "$value": "19px",
        "$description": "Step +1. Small headings, card titles."
      },
      "h2": {
        "$value": "23px",
        "$description": "Step +2. Section headings."
      },
      "h1": {
        "$value": "28px",
        "$description": "Step +3. Page headings."
      },
      "display": {
        "$value": "33px",
        "$description": "Step +4. Display headings — the calm ceiling; the site's 48px hero is marketing scale, not product scale."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "Font weights. Four steps only.",
      "regular": {
        "$value": 400,
        "$description": "Regular — body, metadata, code."
      },
      "medium": {
        "$value": 500,
        "$description": "Medium — labels, display headings."
      },
      "semibold": {
        "$value": 600,
        "$description": "Semibold — headings."
      },
      "bold": {
        "$value": 700,
        "$description": "Bold — emphasis within headings."
      }
    },
    "line-height": {
      "$type": "number",
      "$description": "Line heights, unitless multipliers. Rationalized from the site's ad-hoc 1.06-1.8 band to three steps.",
      "tight": {
        "$value": 1.2,
        "$description": "Display and headings."
      },
      "normal": {
        "$value": 1.5,
        "$description": "Body, labels, code."
      },
      "relaxed": {
        "$value": 1.75,
        "$description": "Long-form reading, notes."
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "$description": "Letter spacing. Headings tighten slightly; labels gain a touch of tracking for legibility.",
      "heading": {
        "$value": "-0.01em",
        "$description": "Display and headings."
      },
      "label": {
        "$value": "0.02em",
        "$description": "Labels and small UI text."
      }
    },
    "role": {
      "$type": "typography",
      "$description": "Composite type roles — the published text styles, each assembled from the scale primitives. Components consume these (not the raw steps) so typography stays consistent.",
      "display": {
        "$value": {
          "font-family": "{font.heading}",
          "font-size": "{type.size.display}",
          "font-weight": "{type.weight.medium}",
          "line-height": "{type.line-height.tight}",
          "letter-spacing": "{type.letter-spacing.heading}"
        },
        "$description": "Display headings."
      },
      "heading": {
        "$value": {
          "font-family": "{font.heading}",
          "font-size": "{type.size.h1}",
          "font-weight": "{type.weight.semibold}",
          "line-height": "{type.line-height.tight}",
          "letter-spacing": "{type.letter-spacing.heading}"
        },
        "$description": "Page headings (h1); h2 and h3 step down through type.size."
      },
      "body": {
        "$value": {
          "font-family": "{font.body}",
          "font-size": "{type.size.body}",
          "font-weight": "{type.weight.regular}",
          "line-height": "{type.line-height.normal}"
        },
        "$description": "Body copy."
      },
      "label": {
        "$value": {
          "font-family": "{font.body}",
          "font-size": "{type.size.label}",
          "font-weight": "{type.weight.medium}",
          "line-height": "{type.line-height.normal}",
          "letter-spacing": "{type.letter-spacing.label}"
        },
        "$description": "Labels, buttons, form captions."
      },
      "metadata": {
        "$value": {
          "font-family": "{font.body}",
          "font-size": "{type.size.metadata}",
          "font-weight": "{type.weight.regular}",
          "line-height": "{type.line-height.normal}"
        },
        "$description": "Captions, timestamps, footnotes."
      },
      "code": {
        "$value": {
          "font-family": "{font.mono}",
          "font-size": "{type.size.label}",
          "font-weight": "{type.weight.regular}",
          "line-height": "{type.line-height.normal}"
        },
        "$description": "Code and data values (monospace)."
      },
      "numeric": {
        "$value": {
          "font-family": "{font.body}",
          "font-size": "{type.size.body}",
          "font-weight": "{type.weight.regular}",
          "line-height": "{type.line-height.normal}",
          "font-variant-numeric": "tabular-nums"
        },
        "$description": "Numeric and tabular data — tabular figures keep digit widths stable."
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "Spacing scale on a 4px base: 4, 8, 12, 16, 24, 32, 48, 64. Covers padding, gaps, page margins and section spacing. Rationalized from the site's ad-hoc values.",
    "xs": {
      "$value": "4px",
      "$description": "Tight internal padding, icon gaps."
    },
    "sm": {
      "$value": "8px",
      "$description": "Component padding, small gaps."
    },
    "md": {
      "$value": "12px",
      "$description": "Default padding, form gaps."
    },
    "lg": {
      "$value": "16px",
      "$description": "Card padding, section gaps."
    },
    "xl": {
      "$value": "24px",
      "$description": "Page margins, panel gaps."
    },
    "2xl": {
      "$value": "32px",
      "$description": "Wide page margins, dialog padding."
    },
    "3xl": {
      "$value": "48px",
      "$description": "Section spacing."
    },
    "4xl": {
      "$value": "64px",
      "$description": "Large section spacing, hero padding."
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corner radii on a 4px base. Rationalized from the site's {5, 6, 8, 10}px set.",
    "sm": {
      "$value": "4px",
      "$description": "Inputs, small controls."
    },
    "md": {
      "$value": "8px",
      "$description": "Cards, buttons, panels."
    },
    "lg": {
      "$value": "12px",
      "$description": "Dialogs, popovers, large surfaces."
    },
    "full": {
      "$value": "9999px",
      "$description": "Pills, badges, avatars."
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation scale — small and discreet (\"calm\"): soft black overlays, no heavy shadows, no glow. Two steps only.",
    "sm": {
      "$value": {
        "color": "rgba(0, 0, 0, 0.24)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      },
      "$description": "Cards on canvas — subtle separation."
    },
    "md": {
      "$value": {
        "color": "rgba(0, 0, 0, 0.32)",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "0px"
      },
      "$description": "Menus, popovers, dialogs — floating layers."
    }
  },
  "motion": {
    "$description": "Motion — minimal (\"calm\"): two durations for the few allowed transitions (focus/hover, open/close) and one standard ease-out easing. The generated CSS includes a prefers-reduced-motion gate that zeroes every duration.",
    "duration": {
      "$type": "duration",
      "$description": "Transition durations.",
      "fast": {
        "$value": "120ms",
        "$description": "Focus and hover feedback."
      },
      "normal": {
        "$value": "200ms",
        "$description": "Open/close and state changes."
      }
