{
  "$schema": "https://www.designtokens.org/schema/2025.10/tokens.json",
  "$description": "Kiso design tokens — DTCG 2025.10. color.* is the primitive palette, semantic.* is the 15 published colour roles (emitted as --color-<role>), and the remaining groups are the non-colour scales: font, type (a minor-third modular scale with composite roles), spacing, radius, shadow, motion, breakpoint. Dark is the default $value; light (\"sand\") lives in $extensions.mode.light. Components consume semantic.* and the scale tokens only.",
  "color": {
    "$type": "color",
    "$description": "Primitive layer — the raw palette. Not consumed directly by components.",
    "white": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      },
      "$description": "Pure white. Light theme elevated surface."
    },
    "black": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
